<!-- 「我的」页上半部分（2026-11-08 照 August 的设计稿）：游戏 ID + 绑定状态、三格统计、每台电脑一张「电脑上的 Evo」卡。
     字段由 evo/utils/view.js 的 meView() 拼好；下面的设置列表在主包 pages/me 里 -->
<view class="evo">
  <block wx:if="{{state === 'loading'}}">
    <view class="me-head"><view class="me-ava"></view><view class="me-skel-line"></view></view>
    <view class="me-card evo-skel"></view>
  </block>

  <view wx:elif="{{state === 'error'}}" class="msg msg-err">
    <text class="msg-title">{{T.evoLoadFail}}</text>
    <text class="msg-body">{{error}}</text>
    <view class="evo-retry" hover-class="evo-pressed" bindtap="load">{{T.evoRetry}}</view>
  </view>

  <block wx:else>
    <!-- 顶上：游戏 ID 首字母的切角方块当头像（不用微信头像昵称：不采集个人信息）；没绑定时方块里是图标 -->
    <view class="me-head">
      <view class="me-ava">
        <text wx:if="{{v.initial}}">{{v.initial}}</text>
        <image wx:else class="me-ava-ic" src="/evo/assets/link-pc.svg" mode="aspectFit"></image>
      </view>
      <view class="evo-grow">
        <text class="me-name">{{v.name}}</text>
        <view class="me-sub">
          <view wx:if="{{v.state === 'ready'}}" class="me-dot"></view>
          <text>{{v.sub}}</text>
        </view>
      </view>
    </view>

    <!-- 三格统计（记录局数 / 赛季最高 / 冠军次数）；没有的那格不出，不写 0 -->
    <view wx:if="{{v.stats.length}}" class="me-stats">
      <view class="me-stat" wx:for="{{v.stats}}" wx:key="key">
        <text class="me-stat-v {{item.small ? 'me-stat-v-s' : ''}}">{{item.v}}</text>
        <text class="me-stat-k">{{item.k}}</text>
      </view>
    </view>

    <!-- 每台电脑一张卡：状态标签带字（不只靠颜色）、几分钟前同步、Evo 版本；解除绑定用强调色文字，点了还要选、要确认 -->
    <view wx:for="{{v.devices}}" wx:key="id" class="me-card">
      <view class="me-pc">
        <image class="me-pc-ic" src="/evo/assets/link-pc.svg" mode="aspectFit"></image>
        <view class="evo-grow">
          <text class="me-pc-t">{{item.title}}</text>
          <text class="me-pc-s">{{item.sub}}</text>
        </view>
        <text class="me-chip me-chip-{{item.chipCls}}">{{item.chip}}</text>
      </view>
      <text class="me-desc">{{T.mePcDesc}}</text>
      <view class="me-btns">
        <view class="me-btn" hover-class="evo-pressed" bindtap="onAccounts">{{T.meManageAccounts}}</view>
        <view class="me-btn me-btn-danger" hover-class="evo-pressed" data-index="{{index}}" bindtap="onUnbind">{{T.meUnbind}}</view>
      </view>
    </view>
    <view wx:if="{{v.state === 'ready'}}" class="me-more" hover-class="evo-pressed" bindtap="onScan">{{T.evoScanAnother}}</view>

    <!-- 没绑定：同一张卡，讲清楚是什么、怎么绑 -->
    <view wx:if="{{v.state === 'unbound'}}" class="me-card">
      <view class="me-pc">
        <image class="me-pc-ic" src="/evo/assets/link-pc.svg" mode="aspectFit"></image>
        <view class="evo-grow">
          <text class="me-pc-t">{{T.mePcTitle}}</text>
          <text class="me-pc-s">{{T.meUnboundCard}}</text>
        </view>
      </view>
      <text class="me-desc">{{T.meUnboundDesc}}</text>
      <view class="evo-cta" hover-class="evo-pressed" bindtap="onScan">{{T.evoScan}}</view>
      <!-- 网址不做"点一下复制"：wx.setClipboardData 是隐私接口（static.test.mjs 的黑名单）；可以长按选中 -->
      <view class="me-site"><text>{{T.meGetEvo}}</text><text class="me-site-url" user-select="{{true}}">evotracker.cn</text></view>
    </view>
  </block>
</view>
