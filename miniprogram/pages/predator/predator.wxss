/* ================= 顶部切换：我的战绩 ｜ 排位资讯（2026-10-27） =================
   两半等宽的胶囊，样子同 app.wxss 的 .langsw（语言开关），但要占满一行、热区 ≥ 80rpx。 */
.segsw {
  display: flex;
  margin-bottom: var(--sp-6);
  padding: var(--sp-1);
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--r-full);
}
.segsw-i {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: var(--r-full);
  font-size: var(--fs-body);
  color: var(--ink2);
}
.segsw-on { color: #ffffff; background: var(--accent); font-weight: var(--fw-bold); }



/* ================= 本赛季段位分布 ================= */
/* 「你在这里」：**文字标记 + 描边一起用**，不拿颜色单独表意（无障碍要求）。 */
.mine {
  background: var(--raised);
  border: 1rpx solid var(--accent);
  border-radius: var(--r-md);
  padding: var(--sp-3) var(--sp-4);
  margin-bottom: var(--sp-2);
}
.mine-h { display: flex; align-items: baseline; margin-bottom: var(--sp-1); }
.mine-k { font-size: var(--fs-min); color: var(--ink3); margin-right: var(--sp-2); }
.mine-tier { font-size: var(--fs-head); font-weight: var(--fw-bold); color: var(--ink); line-height: 1.3; }
.mine-t { font-size: var(--fs-min); color: var(--ink2); display: block; line-height: 1.6; }

/* 每一档一行：名字 / 条形 / 百分比 + 人数。
   名字给到 33% 是留给英文的（"Apex Predator" 在 --fs-min 下约 78px）。 */
.rrow { display: flex; align-items: center; padding: var(--sp-2) 0; border-radius: var(--r-sm); }
.rrow-l { flex: 0 0 33%; min-width: 0; }
.rrow-name {
  display: block;
  font-size: var(--fs-min);
  color: var(--ink2);
  line-height: 1.5;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.rrow-bar { flex: 1 1 auto; height: 12rpx; background: var(--track); border-radius: var(--r-full); margin: 0 var(--sp-3); overflow: hidden; }
.rrow-fill { height: 100%; background: var(--info-ink); border-radius: var(--r-full); }
.rrow-v { flex: 0 0 132rpx; text-align: right; }
.rrow-pct { font-size: var(--fs-sub); font-weight: var(--fw-bold); color: var(--ink); display: block; font-variant-numeric: tabular-nums; }
.rrow-n { font-size: var(--fs-min); color: var(--ink3); display: block; font-variant-numeric: tabular-nums; }
/* 玩家自己那一档：底色 + 名字加重 + 明写"你在这里" */
.rrow-mine { background: var(--raised); }
.rrow-mine .rrow-name { color: var(--ink); font-weight: var(--fw-bold); }
.rrow-mine .rrow-fill { background: var(--accent); }
.rrow-tag { font-size: var(--fs-min); color: var(--accent-ink); display: block; line-height: 1.5; }

/* 选手切换：收起态只占一行（当前是谁 + 箭头），展开才铺竖列表。
   用户 2026-11-07 的要求：主播太多，平铺的标签墙把版面吃光了。 */
.proswitch {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
  margin: 0 0 var(--sp-2);
  padding: var(--sp-3);
  border-radius: var(--r-md);
  background: var(--sunken);
  border: 1rpx solid var(--line);
}
.proswitch-on { background: var(--track); }
.proswitch-l { display: flex; align-items: baseline; gap: var(--sp-2); min-width: 0; }
.proswitch-k { font-size: var(--fs-min); color: var(--ink3); flex: 0 0 auto; }
.proswitch-v {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.proswitch-caret { font-size: var(--fs-min); color: var(--ink3); flex: 0 0 auto; }

/* 展开后的竖列表：限高滚动，避免 40 个主播把页面顶到天边 */
.prolist { margin: 0 0 var(--sp-3); }
.prolist-scroll {
  max-height: 520rpx;
  border-radius: var(--r-md);
  border: 1rpx solid var(--line);
  background: var(--card);
  overflow: hidden;
}
.proitem {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
  padding: var(--sp-3);
  border-bottom: 1rpx solid var(--line);
  font-size: var(--fs-body);
  color: var(--ink2);
}
.proitem:last-child { border-bottom: none; }
.proitem-on { color: var(--ink); font-weight: 600; background: var(--sunken); }
.proitem-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.proitem-dot { color: var(--accent-ink); flex: 0 0 auto; }

/* 选手选择：搜索框（只在选手多的时候出现在展开的竖列表里） */
.prosearch {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  margin: 0 0 var(--sp-2);
  padding: 0 var(--sp-2);
  height: 68rpx;
  border-radius: var(--r-full);
  background: var(--sunken);
  border: 1rpx solid var(--line);
}
.prosearch-in {
  flex: 1 1 auto;
  min-width: 0;
  font-size: var(--fs-min);
  color: var(--ink);
}
.prosearch-x {
  flex: 0 0 auto;
  padding: 6rpx 16rpx;
  border-radius: var(--r-full);
  background: var(--track);
  font-size: var(--fs-min);
  color: var(--ink2);
}
.promore {
  margin: var(--sp-2) 0 var(--sp-3);
  padding: 10rpx 0;
  text-align: center;
  font-size: var(--fs-min);
  color: var(--ink3);
}
